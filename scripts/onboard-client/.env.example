# This script does NOT read credentials from a local .env. Credentials live at the
# user-scope path so multiple repos and chats share the same source of truth:
#
#   ~/.config/wpe/credentials.env
#
# That file should contain:
#   WPE_API_USERNAME=<UUID>
#   WPE_API_PASSWORD=<32-char token>
#
# chmod 600 on the file, chmod 700 on ~/.config/wpe.
# Generate the credentials at https://my.wpengine.com under API Access.
